# Copy to .env for local development. Never commit real secrets.
# Defaults are sufficient for `pnpm dev`.

LEAVEOS_ENV=development
LEAVEOS_HOST=127.0.0.1
LEAVEOS_PORT=3000
LEAVEOS_DATA_DIR=./data
LEAVEOS_PUBLIC_URL=http://localhost:5173
LEAVEOS_BIND_ALL=false
LEAVEOS_LOG_LEVEL=info

# TLS is off in development. Production binds HTTPS on 8443.
LEAVEOS_TLS_ENABLED=false

# Preview-only. Leave unset for the office SQLite product.
# When set (Supabase/Postgres URI), the API uses Postgres instead of the local file.
# Use the Session pooler or direct URI. Never put a Supabase anon key in the browser.
# DATABASE_URL=
# SUPABASE_DB_URL=

# Set automatically on Vercel. Force the same behaviour locally with:
# LEAVEOS_HOSTED_PREVIEW=true
# LEAVEOS_DEMO_ACCOUNTS=true
# LEAVEOS_SEED_DEMO=true
# LEAVEOS_COOKIE_SECURE=true
# LEAVEOS_TRUST_PROXY=true
# CRON_SECRET=
