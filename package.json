{
  "name": "sns-leave-os",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "fastify": "^5.2.1"
  },
  "scripts": {
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "dev": "pnpm --filter @sns/server --filter @sns/web --parallel dev",
    "dev:desktop": "pnpm --filter @sns/desktop dev",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @sns/database migrate",
    "db:reset:navalur": "node scripts/apply-navalur-seed.mjs",
    "seed:demo": "pnpm --filter @sns/server seed:demo",
    "start": "pnpm build && node scripts/start-leaveos.mjs",
    "service": "node scripts/service.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.23.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0",
    "vitest": "^3.0.9"
  }
}
